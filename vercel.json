{
  "builds": [
    {
      "src": "editor/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/analyze-video.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/editor/(.*)",
      "dest": "/editor/$1",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
